# Chave gratuita em https://the-odds-api.com (500 req/mês no free tier)
ODDS_API_KEY=coloque_sua_chave_aqui

# Regiao de referencia das casas de apostas para o mercado h2h (1x2)
# opcoes comuns: eu, uk, us, au
ODDS_API_REGION=eu

# Caminho do banco sqlite local
DB_PATH=./data/loteca.db

# Fase 2 (opcional): sem essas duas chaves, a análise de desfalques é
# pulada e o app funciona só com a Fase 1 (grade + odds).

# Chave gratuita em https://newsapi.org (100 req/dia no free tier, uso não-comercial)
NEWSAPI_KEY=coloque_sua_chave_aqui

# Chave da API da Anthropic, gerada em https://console.anthropic.com
ANTHROPIC_API_KEY=coloque_sua_chave_aqui

# Modelo usado pra classificar desfalques nas notícias (opcional, default abaixo)
ANTHROPIC_MODEL=claude-haiku-4-5

# Fase 4: orçamento em reais pro cartão sugerido (duplos/triplos). Fórmula
# de custo: 2^duplos x 3^triplos x R$2,00 — confira o preço atual no
# site/app da Caixa, esse valor foi pesquisado e pode estar desatualizado.
ORCAMENTO_REAIS=20
